# Public base URL used to build short links (no trailing slash).
HDH_BASE_URL=http://localhost:3000
# SQLite database file. Created and migrated on first start.
HDH_DATABASE_PATH=./data/hdh.db
# Optional: Google Safe Browsing API key. Without it only the local blocklist is checked.
GOOGLE_SAFE_BROWSING_KEY=
# Optional OAuth sign-in. Leave empty to hide the buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional SMTP-less mail outbox: reset emails are written here when no mail provider is set.
HDH_MAIL_OUTBOX=./data/outbox
# Rate limits (creation): burst per 10 minutes, and per UTC day per IP.
HDH_RATE_BURST=120
HDH_RATE_DAILY=300
